---
import Base from '../layouts/Base.astro';
import Tarifs from '../components/Tarifs.astro';
import { site } from '../data/site';
---

<Base
  titre="Horaires et tarifs des cours de yoga à Papeete, Tahiti | Uataa"
  description="Cours de Kundalini Yoga à Papeete, Tahiti, tous les lundis de 17h30 à 18h45 au centre AMA. Première séance offerte, carte de 10 cours ou trimestre, tarifs en XPF."
>
  <div class="entete band">
    <div class="in">
      <p class="sur">Planning et tarifs</p>
      <h1>Cours de yoga à Papeete : tous les lundis, de 17h30 à 18h45</h1>
      <p class="lead">Au centre AMA, {site.lieu.rue}, à {site.lieu.ville}.</p>
    </div>
  </div>

  <section class="deux band">
    <div class="in">
      <div class="bloc">
        <h2>Tarifs des cours</h2>
        <Tarifs detail />
        <p>
          Le règlement se fait auprès de l'association Diwali Yoga, après inscription en ligne&nbsp;:{' '}
          <a class="lien" href={site.inscription} target="_blank" rel="noopener">s'inscrire à Diwali Yoga Tahiti</a>.
        </p>
      </div>
      <div class="bloc">
        <h2>Réserver un cours</h2>
        <p>Séance offerte ou cours habituel, choisissez votre lundi dans le calendrier&nbsp;: votre place est retenue tout de suite.</p>
        <ol class="etapes">
          <li>Vous choisissez une date, puis indiquez votre nom, votre email et s'il s'agit de votre séance offerte ou d'un cours habituel.</li>
          <li>Vous recevez une confirmation, puis un rappel par email.</li>
          <li>Vous venez avec une tenue confortable, le reste est sur place.</li>
        </ol>
        <p>
          Une question, ou pas d'email&nbsp;? Écrivez-moi sur{' '}
          <a class="lien" href={site.reserverWhatsapp} target="_blank" rel="noopener">WhatsApp</a>, par SMS ou appelez-moi au{' '}
          <a class="lien" href={site.tel}>{site.telephone}</a>.
        </p>
        <div><a class="btn" href="#reservation">Choisir ma date</a></div>
      </div>
    </div>
  </section>

  <section class="band" id="reservation">
    <div class="in">
      <div><p class="sur">Réservation en ligne</p><h2>Choisir mon lundi</h2></div>
      <div id="cal-inline" class="cal-cadre"></div>
      <p class="cal-secours">
        Le calendrier ne s'affiche pas&nbsp;?{' '}
        <a class="lien" href={site.reserverCal} target="_blank" rel="noopener">Ouvrir la page de réservation</a>.
      </p>
    </div>
  </section>

  <script is:inline define:vars={{ calLink: site.cal }}>
    (function (C, A, L) { var p = function (a, ar) { a.q.push(ar); }; var d = C.document; C.Cal = C.Cal || function () { var cal = C.Cal; var ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement('script')).src = A; cal.loaded = true; } if (ar[0] === L) { var api = function () { p(api, arguments); }; var namespace = ar[1]; api.q = api.q || []; if (typeof namespace === 'string') { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ['initNamespace', namespace]); } else p(cal, ar); return; } p(cal, ar); }; })(window, 'https://app.cal.com/embed/embed.js', 'init');
    Cal('init', 'cours', { origin: 'https://cal.com' });
    Cal.ns.cours('inline', { elementOrSelector: '#cal-inline', calLink: calLink, config: { layout: 'month_view' } });
    Cal.ns.cours('ui', { hideEventTypeDetails: false, layout: 'month_view', cssVarsPerTheme: { light: { 'cal-brand': '#2a4a6a' } } });
  </script>
</Base>
